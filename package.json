    "test:combined:compatibility": "node scripts/combined-compatibility-check.ts",
    "test:combined:memory": "node scripts/combined-memory-probes.ts",
    "test:browser:combined": "node scripts/combined-browser-check.ts",
    "test:browser:reconstruction": "node scripts/reconstruction-browser-check.ts",
    "test:reconstruction:compatibility": "node scripts/reconstruction-compatibility-check.ts",
    "test:browser:auxiliary": "node scripts/auxiliary-browser-check.ts",
    "test:auxiliary:compatibility": "node scripts/auxiliary-compatibility-check.ts",
    "test:native:compatibility": "node scripts/native-exchange-compatibility-check.ts",
    "test:browser:native": "node scripts/native-exchange-browser-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "ajv": "8.20.0"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "jose": "6.1.3"
