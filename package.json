{
  "name": "brand-visual-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:design-os": "node scripts/smoke-design-os.ts",
    "build": "node scripts/build.ts",
    "dev": "npm run build && node scripts/dev.ts",
    "review:visual": "npm run build && node scripts/visual-review.ts",
    "test:browser:visual": "node scripts/visual-browser-check.ts",
    "test:browser": "node scripts/browser-check.ts",
    "test:browser:providers": "node scripts/provider-browser-check.ts",
    "test:browser:regions": "node scripts/region-browser-check.ts",
    "test:browser:composition": "node scripts/composition-browser-check.ts",
    "test:browser:readiness": "node scripts/readiness-browser-check.ts",
    "test:browser:ai-assets": "node scripts/ai-assets-browser-check.ts",
    "test:browser:pages": "node scripts/pages-browser-check.ts",
    "test:browser:review-repairs": "node scripts/review-repairs-browser-check.ts",
    "test:browser:memory": "node scripts/memory-browser-check.ts",
    "test:browser:library": "node scripts/library-browser-check.ts",
    "test:browser:execution": "node scripts/execution-browser-check.ts",
    "test:browser:chat": "node scripts/chat-browser-check.ts",
    "test:page-contract": "node scripts/page-contract-check.ts",
